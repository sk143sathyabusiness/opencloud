{
  "name": "opencloud",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "frontend/dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "opencloud",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_MODE": "local"
  }
}
